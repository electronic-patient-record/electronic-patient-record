# Build output and local state that must never be tracked, anywhere in the tree.
target/
node_modules/
.svelte-kit/
test-results/
playwright-report/
build/
dist/
.vite/
__pycache__/
*.pyc
# Coverage, with paths of the machine it was made on.
lcov.info
*.profraw

# Local environment and secrets (examples stay tracked).
.env
.env.*
!.env.example
.DS_Store
*.log

# Local config overrides.
**/config/local.yaml
**/config/*.local.yaml
chaos-report.json

# Downloaded tools (scripts/fhir-validator.sh).
.cache/

# cargo-mutants output (scripts/mutants.sh).
mutants.out/
mutants.out.old/

# The pinned Lily Design System checkout (scripts/fetch-lily.sh) and mobile build state.
vendor/
.build/
.swiftpm/
xcuserdata/
*.xcuserstate
DerivedData/
.gradle/
.kotlin/
local.properties
